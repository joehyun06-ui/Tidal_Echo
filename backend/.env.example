# ============================================================
#  companion relay — environment template
#  Copy to  relay.env  and fill in. NEVER commit the filled file.
#    cp .env.example relay.env && chmod 600 relay.env
# ============================================================

# ---- REQUIRED: shared auth secret --------------------------------
# ONE secret guards every endpoint. The PWA and the local channel plugin
# both send it as a Bearer token. Generate a fresh random one (do NOT reuse
# anyone else's):
#     python3 -c "import secrets; print(secrets.token_urlsafe(32))"
RELAY_SECRET=

# ---- identity (your names) ---------------------------------------
RELAY_AI_NAME=Claude          # <- your AI companion's display name (push title, narration)
RELAY_HUMAN_NAME=你的名字       # <- how the AI is told about you in voice/call narration ("…开启了语音通话")

# ---- paths / network ---------------------------------------------
RELAY_PORT=3011
RELAY_DB=/root/companion-relay/relay.db
RELAY_UPLOAD_DIR=/root/companion-relay/uploads
# Public URL prefix nginx mounts the API under (MUST match your nginx `location`).
# Upload URLs are built as  <prefix>/uploads/<file>  — so this must be correct.
RELAY_PUBLIC_PREFIX=/relay
# Where a push-notification tap should open the PWA (your nginx static prefix).
RELAY_APP_PATH=/chat/
# CORS allow-list (comma separated). Put your real https origin first.
RELAY_ALLOW_ORIGINS=https://your-domain.example,http://localhost:8080

# ---- optional API loop routing -----------------------------------
# Default "desktop" means PWA messages go to the Claude Code channel plugin.
# POST /app/brain {"target":"loop"} writes RELAY_BRAIN_FILE and sends new
# messages to RELAY_LOOP_INGEST_URL instead.
RELAY_BRAIN_FILE=/root/companion-relay/brain_target
RELAY_BRAIN_TARGET=
RELAY_LOOP_INGEST_URL=http://127.0.0.1:3020/loop/ingest
LOOP_PORT=3020
LOOP_CONFIG=/root/companion-loop/api_loop.config.json
LOOP_MODEL_TOTAL_TIMEOUT_SECONDS=120
LOOP_CALLBACK_TIMEOUT_SECONDS=30
# Dispatch must be >= model total + callback + safety margin.
LOOP_TIMEOUT_SAFETY_MARGIN_SECONDS=15
LOOP_DISPATCH_TIMEOUT_SECONDS=180

# ---- Kelivo OpenAI-compatible API (OPTIONAL; disabled by default) ---
# This key is only for /v1/* and must differ from every relay, Telegram,
# audit, and upstream model secret. Never put it in a URL query parameter.
KELIVO_ENABLED=false
KELIVO_API_KEY=
KELIVO_CLIENT_ID=primary-kelivo
# Set this explicitly to the stable api_session Kelivo should share. To share
# with one Telegram conversation, use that conversation's existing api_session.
KELIVO_API_SESSION=
KELIVO_MODEL_ALIAS=ouou-home
KELIVO_GLOBAL_CONCURRENCY=2
KELIVO_CLIENT_CONCURRENCY=1
KELIVO_RATE_LIMIT_PER_MINUTE=10
KELIVO_QUEUE_TIMEOUT_SECONDS=2
KELIVO_DISPATCH_STALE_SECONDS=300
# Compatibility for clients such as the current Kelivo GUI that omit
# Idempotency-Key. Keep disabled when the client can send an explicit key.
# When enabled, replay seconds must be 60..3600 and greater than dispatch stale.
KELIVO_AUTO_IDEMPOTENCY_ENABLED=false
KELIVO_AUTO_IDEMPOTENCY_REPLAY_SECONDS=300
SQLITE_BUSY_TIMEOUT_SECONDS=30
KELIVO_COMPLETION_COMMIT_MARGIN_SECONDS=15
KELIVO_INTERNAL_RESPONSE_MAX_BYTES=1048576
# Remapping an existing client is denied unless this is deliberately true for
# one restart. Set it back to false immediately after verifying the audit log.
KELIVO_ALLOW_SESSION_REMAP=false
# Set true when the target must be an active, allowlisted Telegram conversation.
KELIVO_REQUIRE_TELEGRAM_SESSION=false

# ---- Operit Share MVP (OPTIONAL; disabled by default) --------------
# Dedicated low-privilege key accepted only by POST /v1/operit/share.
# It must differ from KELIVO_API_KEY and every relay/Telegram/model secret.
# The endpoint reuses the server-verified KELIVO_API_SESSION; clients cannot
# provide or remap a session. Never put a real key in this example file.
OPERIT_SHARE_ENABLED=false
OPERIT_SHARE_API_KEY=
OPERIT_SHARE_CLIENT_ID=primary-operit-share
# Fixed protocol alias. Any other value fails closed when enabled.
OPERIT_SHARE_MODEL_ALIAS=ouou-home

# Required when app.py/api_loop.py are launched manually. render_start.py
# generates a fresh shared child-process token on every supervisor start.
API_LOOP_INTERNAL_TOKEN=
LOOP_INTERNAL_REQUEST_MAX_BYTES=1048576
LOOP_PROVIDER_RESPONSE_MAX_BYTES=1048576
LOOP_ASSISTANT_MAX_CHARS=64000
# Independent, read-only transient handoff context; not part of MemoryConfig.
TRANSIENT_CONTINUITY_ENABLED=false

# ---- Codex App Server provider control plane (disabled; no generation) ----
CODEX_CONTROL_ENABLED=false
CODEX_HOME=/var/data/codex-home
CODEX_WORKSPACE=/var/data/codex-workspace
CODEX_APP_SERVER_REQUEST_TIMEOUT_SECONDS=10
# Kelivo freezes these defaults during request preparation. LLM_MODEL is the
# real provider model; KELIVO_MODEL_ALIAS remains the public virtual alias.
LLM_MODEL=
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=2000

# ---- Dylan Heartbeat Foundation (LOCAL-ONLY; disabled by default) --------
# This phase exposes only a single bounded service call. It has no scheduler,
# provider call, Telegram/ntfy delivery, public endpoint, or infinite loop.
HEARTBEAT_ENABLED=false
HEARTBEAT_INTERVAL_SECONDS=300
HEARTBEAT_TIMEZONE=UTC
HEARTBEAT_QUIET_HOURS_START=22:00
HEARTBEAT_QUIET_HOURS_END=08:00
HEARTBEAT_CONTACT_COOLDOWN_SECONDS=21600
# Bump deliberately whenever interval/timezone/quiet-hours/cooldown changes.
HEARTBEAT_SCHEDULE_REVISION=default

# ---- Memory Core Phase 1 (OPTIONAL; explicit and disabled by default) ----
# Phase 1 provides only internal explicit create/correct/forget primitives. It
# does not call a model, scan canonical history, inject prompt context, or add
# a public HTTP endpoint.
MEMORY_CORE_ENABLED=false
# Kelivo-only, read-only transient context injection. Requires Memory Core and
# Kelivo, but not explicit writes, explicit entry, or sensitive storage.
MEMORY_CONTEXT_INJECTION_ENABLED=false
# Deterministic lexical relevance selection for the transient Kelivo Memory
# path. Requires Memory Core and Context Injection. Disabled by default.
MEMORY_SMART_RETRIEVAL_ENABLED=false
# Best-effort structural comparison of Retrieval V2 against the authoritative
# V1 selection. Requires Smart Retrieval. V1 remains provider-visible authority.
MEMORY_RETRIEVAL_V2_SHADOW_ENABLED=false
# Provider-visible Retrieval V2 authority. Requires Smart Retrieval and cannot
# be enabled together with the shadow comparator. V1 remains rollback baseline.
MEMORY_RETRIEVAL_V2_ACTIVE_ENABLED=false
# Automatic formation may propose canonical source spans, but does not persist
# them unless the independent candidate-only flag below is also enabled.
MEMORY_AUTO_FORMATION_ENABLED=false
# Future non-empty Web/PWA and fresh private Telegram text may share the same
# best-effort formation slot as Kelivo. Requires Auto Formation; default off.
MEMORY_NATURAL_INGRESS_FORMATION_ENABLED=false
# Default off. This authorizes only future automatic status='candidate'
# persistence, never active Memory. It is not an explicit-write capability and
# does not require sensitive storage. Requires Core, Kelivo, Auto Formation,
# and a valid pinned fingerprint profile.
MEMORY_AUTO_CANDIDATE_PERSISTENCE_ENABLED=false
# Read-only internal review of validated status='candidate' Memory rows. This
# grants no write, promotion, rejection, runtime, adapter, or public-route
# authority. Requires only Core and a valid pinned fingerprint profile.
MEMORY_CANDIDATE_REVIEW_ENABLED=false
MEMORY_CANDIDATE_DECISIONS_ENABLED=false
MEMORY_EXPLICIT_WRITES_ENABLED=false
# Internal composition only. This adds no route, CLI, MCP tool, or adapter.
# Enable only with Core, explicit writes, a valid fingerprint profile, and a
# validated v7/v8 schema. Production remains false until separate approval.
MEMORY_EXPLICIT_ENTRY_ENABLED=false
MEMORY_SENSITIVE_STORAGE_ENABLED=false
MEMORY_MAX_ITEM_CHARS=1000
MEMORY_FORGET_RETENTION_POLICY=tombstone_without_content
# Required when Memory Core uses explicit writes, automatic candidate
# persistence, or candidate review. Generate
# a dedicated random secret (32-512 printable ASCII characters) and do not reuse
# any relay, Telegram, Kelivo, Operit, model, audit, or API-loop credential.
# Key ID and Secret form a pinned fingerprint profile. Phase 1 fails closed if
# either changes; rotate only through a separately reviewed explicit migration.
MEMORY_FINGERPRINT_KEY_ID=
MEMORY_FINGERPRINT_HMAC_SECRET=

# ---- upload limits -----------------------------------------------
RELAY_MAX_UPLOAD_BYTES=10485760   # 10 MB (keep <= nginx client_max_body_size)
RELAY_VOICE_MAX_BYTES=8388608     # 8 MB
# Optional local ASR hook: a command taking  <audio_path> <mime>  that prints a transcript.
# Leave blank to just deliver voice as an audio attachment.
RELAY_VOICE_TRANSCRIBE_CMD=

# ---- MiniMax TTS (OPTIONAL — leave keys blank to disable spoken replies) ----
# Get your own keys at the MiniMax console and create a voice id.
MINIMAX_API_BASE=https://api.minimaxi.com
MINIMAX_API_KEY=
MINIMAX_GROUP_ID=
MINIMAX_MODEL=speech-02-hd
MINIMAX_VOICE_ZH=
MINIMAX_TTS_TIMEOUT=30

# ---- Web Push / VAPID (OPTIONAL — leave blank to disable lock-screen push) ----
# Generate your OWN key pair (see DEPLOY.md, "Web Push"). Never reuse another's.
#   VAPID_PUBLIC_KEY  = the base64url applicationServerKey the browser subscribes with
#   VAPID_PRIVATE_PEM = path to private_key.pem (or the inline PEM text)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_PEM=/root/companion-relay/private_key.pem
VAPID_SUBJECT=mailto:you@your-domain.example

# ---- presence tuning (seconds) -----------------------------------
RELAY_PRESENCE_ONLINE_SEC=180
RELAY_PRESENCE_RECENT_SEC=1800

# ---- Telegram private-text MVP (OPTIONAL; enabled config is fail-fast) ----
# Create separate development/production bots manually with BotFather. Keep the
# real token and webhook secret only in the server environment file.
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=replace-with-server-secret
TELEGRAM_WEBHOOK_SECRET=replace-with-random-server-secret
# Invalid placeholder only; generate a separate server-only secret.
CHANNEL_AUDIT_HMAC_SECRET=replace-with-random-audit-hmac-secret
# Internal stable namespace for this Bot deployment. It is not parsed from the
# Bot Token and is never sent to Telegram; keep it stable across restarts.
TELEGRAM_BOT_ACCOUNT_ID=replace-with-stable-bot-account-id
TELEGRAM_ALLOWED_USER_IDS=100000001
TELEGRAM_ALLOWED_CHAT_IDS=100000001
TELEGRAM_API_BASE=https://api.telegram.org
TELEGRAM_API_BASE_ALLOWLIST=
TELEGRAM_MAX_TEXT_LENGTH=4096
TELEGRAM_WEBHOOK_MAX_BODY_BYTES=65536
TELEGRAM_WORKER_POLL_SECONDS=1
TELEGRAM_GENERATION_MAX_ATTEMPTS=2

# ---- Render Telegram MVP deployment mode (OPTIONAL) ----------------
# Enable only for the single-instance Render layout documented in
# RENDER_TELEGRAM.md. All four persistence paths must be below this root.
RENDER_TELEGRAM_MVP=false
RENDER_PERSISTENT_ROOT=/var/data
# Deployment booleans accept only: 1/true/yes/on or 0/false/no/off.
# Render production must leave TELEGRAM_TEST_MODE=false and all fallback
# LLM_API_BASE_2..4 / LLM_API_KEY_2..4 / LLM_MODEL_2..4 unset.
TELEGRAM_TEST_MODE=false
